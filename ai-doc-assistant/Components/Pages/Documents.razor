@page "/documents"
@inject DocumentProcessingService DocumentService

<PageTitle>Documents — ai-doc-assistant</PageTitle>

<h1>Documents</h1>

<section class="card upload-card">
    <h2>Upload</h2>
    <p class="muted">PDF or image — parse, OCR if needed, then LLM extraction and RAG index. After submit, wait for DeepSeek (and Ollama if indexing).</p>

    <form method="post" action="/documents/upload" enctype="multipart/form-data">
        <input type="file" name="file" accept=".pdf,.png,.jpg,.jpeg,.webp,.tif,.tiff" required />
        <button type="submit" class="btn btn-primary">Upload</button>
    </form>

    <p class="muted">If Visual Studio dies on the file dialog, paste a local path and use this instead:</p>
    <form method="post" action="/documents/upload-path">
        <input type="text" name="path" class="path-input" placeholder="C:\Users\...\invoice.pdf" />
        <button type="submit" class="btn btn-primary">Upload path</button>
    </form>
</section>

@if (_documents.Count == 0)
{
    <p class="muted">No documents yet — upload the first file.</p>
}
else
{
    <section class="card">
        <table class="data-table">
            <thead>
                <tr>
                    <th>File</th>
                    <th>Status</th>
                    <th>OCR</th>
                    <th>Size</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var doc in _documents)
                {
                    <tr>
                        <td><a href="/documents/@doc.Id">@doc.FileName</a></td>
                        <td><span class="badge @StatusClass(doc.Status)">@doc.Status</span></td>
                        <td>@(doc.UsedOcr ? "yes" : "no")</td>
                        <td>@FormatSize(doc.SizeBytes)</td>
                        <td>@doc.CreatedAt.ToLocalTime().ToString("g")</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

@code {
    private IReadOnlyList<DocumentListItemDto> _documents = [];

    protected override async Task OnInitializedAsync()
    {
        _documents = await DocumentService.GetAllAsync();
    }

    private static string FormatSize(long bytes) =>
        bytes switch
        {
            var size when size < 1024 => $"{size} B",
            var size when size < 1024 * 1024 => $"{size / 1024.0:0.#} KB",
            var size => $"{size / (1024.0 * 1024.0):0.#} MB"
        };

    private static string StatusClass(string status) => status.ToLowerInvariant() switch
    {
        "extracted" => "success",
        "failed" => "danger",
        "parsed" => "warning",
        _ => "neutral"
    };
}
