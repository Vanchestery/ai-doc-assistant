@page "/documents"
@inject DocumentProcessingService DocumentService
@inject IWebHostEnvironment Env

<PageTitle>Documents — ai-doc-assistant</PageTitle>

<div class="page-header">
    <div>
        <h1>Documents</h1>
        <p class="muted">Upload, extract, and open any invoice for fields, chat, or agent tools.</p>
    </div>
</div>

<section class="card upload-card">
    <h2>Upload</h2>
    <p class="muted">PDF or image — parse, OCR if needed, then LLM extraction and RAG index.</p>

    <form method="post" action="/documents/upload" enctype="multipart/form-data" class="upload-form" id="upload-form">
        <label class="dropzone" id="dropzone" for="document-file">
            <input id="document-file"
                   class="dropzone-input"
                   type="file"
                   name="file"
                   accept=".pdf,.png,.jpg,.jpeg,.webp,.tif,.tiff"
                   required />
            <span class="dropzone-icon" aria-hidden="true">↑</span>
            <span class="dropzone-title">Drop a PDF or image here</span>
            <span class="dropzone-hint">or click to browse · PDF, PNG, JPG, WEBP, TIFF</span>
            <span class="dropzone-file" id="dropzone-file">No file selected</span>
        </label>
        <button type="submit" class="btn btn-primary upload-submit">Upload &amp; extract</button>
    </form>

    @if (Env.IsDevelopment())
    {
        <p class="upload-dev-tip">
            Dev tip: under Visual Studio (F5), prefer <strong>drag-and-drop</strong>.
            The Browse dialog often kills the debugger (<code>exited -1</code>).
        </p>
    }
</section>

<script>
(() => {
    const input = document.getElementById('document-file');
    const zone = document.getElementById('dropzone');
    const label = document.getElementById('dropzone-file');
    if (!input || !zone || !label) return;

    const setName = () => {
        label.textContent = input.files?.[0]?.name || 'No file selected';
        zone.classList.toggle('has-file', Boolean(input.files?.length));
    };

    input.addEventListener('change', setName);

    ['dragenter', 'dragover'].forEach((eventName) => {
        zone.addEventListener(eventName, (event) => {
            event.preventDefault();
            zone.classList.add('is-dragover');
        });
    });

    ['dragleave', 'drop'].forEach((eventName) => {
        zone.addEventListener(eventName, (event) => {
            event.preventDefault();
            zone.classList.remove('is-dragover');
        });
    });

    zone.addEventListener('drop', (event) => {
        const files = event.dataTransfer?.files;
        if (!files?.length) return;
        const transfer = new DataTransfer();
        transfer.items.add(files[0]);
        input.files = transfer.files;
        setName();
    });
})();
</script>

@if (_documents.Count == 0)
{
    <p class="muted">No documents yet — upload the first file.</p>
}
else
{
    <section class="card">
        <table class="data-table">
            <thead>
                <tr>
                    <th>File</th>
                    <th>Status</th>
                    <th>OCR</th>
                    <th>Size</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var doc in _documents)
                {
                    <tr>
                        <td><a href="/documents/@doc.Id">@doc.FileName</a></td>
                        <td><span class="badge @StatusClass(doc.Status)">@doc.Status</span></td>
                        <td>@(doc.UsedOcr ? "yes" : "no")</td>
                        <td>@FormatSize(doc.SizeBytes)</td>
                        <td>@doc.CreatedAt.ToLocalTime().ToString("g")</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

@code {
    private IReadOnlyList<DocumentListItemDto> _documents = [];

    protected override async Task OnInitializedAsync()
    {
        _documents = await DocumentService.GetAllAsync();
    }

    private static string FormatSize(long bytes) =>
        bytes switch
        {
            var size when size < 1024 => $"{size} B",
            var size when size < 1024 * 1024 => $"{size / 1024.0:0.#} KB",
            var size => $"{size / (1024.0 * 1024.0):0.#} MB"
        };

    private static string StatusClass(string status) => status.ToLowerInvariant() switch
    {
        "extracted" => "success",
        "failed" => "danger",
        "parsed" => "warning",
        _ => "neutral"
    };
}
