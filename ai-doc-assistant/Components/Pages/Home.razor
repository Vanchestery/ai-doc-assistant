@page "/"

<PageTitle>ai-doc-assistant</PageTitle>

<section class="home-hero">
    <div class="home-hero-inner">
        <p class="home-kicker">Portfolio document AI demo</p>
        <h1>Document AI assistant</h1>
        <p class="lead">
            Tell the agent what to do with your invoices — reconcile, summarize, report —
            or open documents first if you still need to upload.
        </p>
        <div class="hero-actions">
            <a class="btn btn-primary" href="/agent">Ask the agent</a>
            <a class="btn btn-secondary" href="/documents">Open documents</a>
        </div>
    </div>
</section>

<section class="home-features">
    <div class="home-features-inner">
        <div class="card-grid">
            <article class="feature-card">
                <span class="feature-index">01</span>
                <h2>Agent</h2>
                <p>Goal mode picks reconcile, summarize, or Excel report from plain language.</p>
            </article>
            <article class="feature-card">
                <span class="feature-index">02</span>
                <h2>Extraction</h2>
                <p>Structured invoice fields: number, date, counterparty, totals, confidence.</p>
            </article>
            <article class="feature-card">
                <span class="feature-index">03</span>
                <h2>RAG chat</h2>
                <p>Questions over document text with citations from indexed chunks.</p>
            </article>
            <article class="feature-card">
                <span class="feature-index">04</span>
                <h2>Metrics</h2>
                <p>Tokens, latency p50/p95, estimated cost, and the offline eval suite.</p>
            </article>
        </div>
    </div>
</section>
