<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AiDocAssistant.Core</RootNamespace>
    <AssemblyName>AiDocAssistant.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Vector type for Chunk embeddings. Tiny package (value type only);
         EF integration (Pgvector.EntityFrameworkCore) stays in Infrastructure. -->
    <PackageReference Include="Pgvector" Version="0.3.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Evals\Golden\*.json" />
  </ItemGroup>

</Project>
